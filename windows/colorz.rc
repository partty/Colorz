// Windows resources linked into colorz.exe: the app icon and version
// information. build.rs compiles this with windres, defining
// COLORZ_VERSION (e.g. 0.1.1) and COLORZ_VERSION_NUM (e.g. 0,1,1,0). The
// version is passed bare and stringized here, because quotes in a -D value
// do not survive MSYS2 windres. The file is ASCII; "\251" is the copyright
// sign in code page 1252.
#pragma code_page(1252)

#define COLORZ_STR2(x) #x
#define COLORZ_STR(x) COLORZ_STR2(x)
#define COLORZ_VERSION_STR COLORZ_STR(COLORZ_VERSION)

// Ordinal 1: the window and notification-area icon.
1 ICON "colorz.ico"

1 VERSIONINFO
FILEVERSION COLORZ_VERSION_NUM
PRODUCTVERSION COLORZ_VERSION_NUM
FILEFLAGSMASK 0x3f
FILEFLAGS 0x0
// VOS_NT_WINDOWS32, VFT_APP
FILEOS 0x40004
FILETYPE 0x1
FILESUBTYPE 0x0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // U.S. English, Unicode
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Colorz"
            VALUE "FileVersion", COLORZ_VERSION_STR
            VALUE "LegalCopyright", "\251 2026 Ogi Tsonev, GPL-3.0-or-later"
            VALUE "ProductName", "Colorz"
            VALUE "ProductVersion", COLORZ_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
